[Unit]
Description=Plane Tracker RGB LED Matrix Display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Secrets and config loaded from environment file
EnvironmentFile=/etc/plane-tracker.env
WorkingDirectory=__REPO_DIR__/its-a-plane-python
Environment=PLANE_TRACKER_DATA_DIR=/var/lib/plane-tracker
# Cap glibc malloc arenas — REQUIRED on 512MB Pis, see CLAUDE.md "glibc arena cap".
# The poll starts a fresh thread each cycle; glibc gives each new thread its own
# arena (default ceiling 8*nproc), so per-poll C-level allocations scatter, freed
# chunks interleave with live ones, malloc_trim() can only return fully-free pages,
# and the heap ratchets into SD-card swap -> visible scroll stutter.
# NOTE: this works here because ExecStart runs python directly. If you change
# ExecStart to go through sudo, this line is SILENTLY DROPPED (sudo env_reset) and
# it must become a `sudo MALLOC_ARENA_MAX=2 ...` argument instead.
Environment=MALLOC_ARENA_MAX=2

# Ensure writable data directory exists
ExecStartPre=/bin/bash -c "mkdir -p /var/lib/plane-tracker/maps"

ExecStart=__REPO_DIR__/.venv/bin/python3 __REPO_DIR__/its-a-plane-python/its-a-plane.py
Restart=on-failure
RestartSec=10
# Run as root for GPIO / LED matrix access
User=root
Group=root

[Install]
WantedBy=multi-user.target
